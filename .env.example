# Server
PORT=8080
# q-story-web's browser traffic reaches this backend only via its same-origin Vercel proxy
# (server-to-server, no Origin header), so these origins matter for direct/local-dev callers only.
# The tablet/phone app's WebView origins are NOT listed here - application.yml's qstory.native-origins
# is always appended by SecurityConfig, whatever this variable says.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:5173,http://127.0.0.1:5173

# Supabase Postgres (Session Pooler / direct connection string from Supabase project settings)
SUPABASE_DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=

# Supabase REST/Storage (service role - server-side only, never ship to a client). This backend
# is the only thing that talks to Supabase - the browser never calls Supabase directly.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_VOICE_RESEARCH_BUCKET=qstory-voice-research
SUPABASE_SHADOW_ASSETS_BUCKET=qstory-shadow-assets
# Public bucket for tutor profile photos (create it as public in Supabase Storage).
SUPABASE_PROFILE_IMAGE_BUCKET=qstory-profile-images
# Public buckets the story player fetches illustrations and narration from. Upload the imported
# static assets with fe `npm run assets:upload` (object name <slug>/<file>); re-rendered narration
# and live-branch art are written here by the backend itself.
SUPABASE_STORY_AUDIO_BUCKET=qstory-story-audio
SUPABASE_STORY_IMAGE_BUCKET=qstory-story-images

# Shared secret for POST /v1/admin/stories/import (fe/q-story-web's scripts/import-story-to-backend.mjs
# sends this as the X-Admin-Token header). Not set = the import endpoint always 500s.
QSTORY_STORY_IMPORT_TOKEN=

# Retention (days) for conversation_record - the append-only log of everything the child said
# (STT transcripts / typed text) and every character reply. No read API exists; only this
# scheduler touches it. 0 or less disables deletion. Keep in line with the published privacy notice.
QSTORY_CONVERSATION_RECORD_RETENTION_DAYS=365

# STT provider (RTZR / Return Zero)
RTZR_CLIENT_ID=
RTZR_CLIENT_SECRET=

# LLM + image provider (OpenRouter) - TTS moved off OpenRouter, see GEMINI_* below.
OPENROUTER_API_KEY=
OPENROUTER_LLM_MODEL=google/gemini-3.6-flash
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image

# TTS provider (Gemini, called directly - google/gemini-*-tts-preview isn't in OpenRouter's
# model catalog, so this bypasses OpenRouter entirely). GeminiTtsClient.java.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Sulafat

# Audio normalization
FFMPEG_PATH=ffmpeg

# HMAC key for this app's own access tokens (JwtService). Must be >= 32 bytes or Keys.hmacShaKeyFor
# rejects it; generate with `openssl rand -base64 48`. Not set = every signup/login/whoami 500s,
# since JwtService.key() throws before a token can be issued.
QSTORY_JWT_SECRET=

# Social login. Both are public identifiers (the same values the frontend SDKs use); unset = that
# provider's /v1/auth/oauth/* endpoint answers 503 OAUTH_PROVIDER_NOT_CONFIGURED.
GOOGLE_OAUTH_CLIENT_ID=
KAKAO_APP_ID=

# Toss Payments secret key is backend-only.
TOSS_SECRET_KEY=
TOSS_PARENT_MONTHLY_AMOUNT=9900
# 기관 이용권 = 결제 시점의 학생 수 x 이 금액. 비워 두거나 0이면 기관 결제가 열리지 않는다.
TOSS_ORGANIZATION_STUDENT_MONTHLY_AMOUNT=0
TOSS_ACCESS_DAYS=30

# 앱 푸시(FCM HTTP v1). Firebase 서비스 계정 키 JSON 원문 또는 그 base64(한 줄). 비우면 푸시 없이 인앱 알림만 쌓인다
# (부팅 로그 fcm.disabled). 프로젝트 id는 비우면 JSON의 project_id를 쓴다.
QSTORY_FCM_SERVICE_ACCOUNT_JSON=
QSTORY_FCM_PROJECT_ID=

# Optional Grafana Cloud Loki log shipping (logback-spring.xml). Unset LOKI_URL = console logs only.
# LOKI_API_KEY must be an access-policy token with the logs:write scope. Keep these commented out
# unless set: an empty LOKI_URL still counts as defined and turns the appender on.
# LOKI_URL=https://<host>/loki/api/v1/push
# LOKI_USERNAME=
# LOKI_API_KEY=
