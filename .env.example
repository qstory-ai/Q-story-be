# Server
PORT=8080
# q-story-web's browser traffic reaches this backend only via its same-origin Vercel proxy
# (server-to-server, no Origin header), so these origins matter for direct/local-dev callers only.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:5173,http://127.0.0.1:5173

# Supabase Postgres (Session Pooler / direct connection string from Supabase project settings)
SUPABASE_DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=

# Supabase REST/Storage (service role - server-side only, never ship to a client). This backend
# is the only thing that talks to Supabase - the browser never calls Supabase directly.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_VOICE_RESEARCH_BUCKET=qstory-voice-research
SUPABASE_SHADOW_ASSETS_BUCKET=qstory-shadow-assets
QSTORY_RESEARCH_CLEANUP_TOKEN=

# Shared secret for POST /v1/admin/stories/import (fe/q-story-web's scripts/import-story-to-backend.mjs
# sends this as the X-Admin-Token header). Not set = the import endpoint always 500s.
QSTORY_STORY_IMPORT_TOKEN=

# STT provider (RTZR / Return Zero)
RTZR_CLIENT_ID=
RTZR_CLIENT_SECRET=

# LLM + TTS provider (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_LLM_MODEL=google/gemini-3.6-flash
OPENROUTER_TTS_MODEL=google/gemini-3.1-flash-tts-preview
OPENROUTER_TTS_VOICE=Sulafat
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image

# Audio normalization
FFMPEG_PATH=ffmpeg
