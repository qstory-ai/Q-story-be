# Default: let Git detect text vs binary, normalize text files to LF in the
# repo, and check them out as LF everywhere (Windows included).
* text=auto eol=lf

# Windows-only entry points must keep CRLF or cmd.exe's parser breaks.
*.bat text eol=crlf
*.cmd text eol=crlf

# Unix shell scripts / Gradle wrapper run inside the Linux Docker image
# (see Dockerfile) - CRLF here fails at the shebang with "bash\r: No such
# file or directory".
*.sh text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf

# Binary — never diff/merge as text.
*.jar binary
*.p12 binary
*.keystore binary
